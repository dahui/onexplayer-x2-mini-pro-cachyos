# Maintainer: Jeff Hagadorn <jeff@aletheia.io>
#
# Patched oxpec EC driver for the ONEXPLAYER X2Mini PRO.
#
# Stock oxpec has no DMI entry for this machine, so fan RPM/PWM and the battery
# charge limit are unavailable. This adds the entry, reusing the APEX's board
# type (oxp_fly) unchanged -- same system board.
#
# The package name is deliberately distinct from any upstream oxpec package, but
# the *module* it builds is still oxpec.ko. That is required: the module name is
# what binds the hardware and what modprobe and the shipped configs reference.
# DKMS installs it under /updates, which takes precedence over the in-tree
# module. Do not "fix" the mismatch between package and module name.

# Self-contained: the driver sources sit next to this file, so it builds from a
# bare checkout with no published release. arch=any because DKMS packages ship
# source -- the user's own machine compiles the module against their kernel,
# which is what makes a CI-built package portable.
pkgname=oxpec-x2mini-dkms
pkgver=0.1.0
pkgrel=1
_modver=1.0
pkgdesc="OneXPlayer EC driver (fan, charge limit) with ONEXPLAYER X2Mini PRO support - DKMS"
arch=('any')
url="https://github.com/dahui/onexplayer-x2-mini-pro-cachyos"
license=('GPL-2.0-or-later')
depends=('dkms')
install="$pkgname.install"
provides=('oxpec-x2mini')
conflicts=('oxpec-x2mini')
source=('oxpec.c' 'Makefile' 'dkms.conf')
sha256sums=('fd5c591338ef01abd7e517573cea10fc0a13595d181a5791aadec03627350067'
            '32dae33d7bf42c42e987e3b08a6793dd57527add921a39398beb3e76d942ddf1'
            'b59d2d967a2cb63adc3b49e8c90adc648924d001944ffa1dcb81226978d5aa70')

package() {
	local dest="$pkgdir/usr/src/oxpec-x2mini-$_modver"
	install -Dm644 "$srcdir/oxpec.c"   "$dest/oxpec.c"
	install -Dm644 "$srcdir/Makefile"  "$dest/Makefile"
	install -Dm644 "$srcdir/dkms.conf" "$dest/dkms.conf"

	install -Dm644 "$startdir/../../LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
