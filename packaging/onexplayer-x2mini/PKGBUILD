# Maintainer: Jeff Hagadorn <jeff@aletheia.io>
#
# Configuration for the ONEXPLAYER X2Mini PRO: steamos-manager device profile,
# InputPlumber composite device + capability map, udev hwdb autostart trigger,
# and the gamescope display script that enables HDR.
#
# This is the "everything else" package -- it pulls in the daemon and the two
# DKMS modules, so `paru -S onexplayer-x2mini` is the single command.
#
# It deliberately does NOT touch the kernel command line. Suspend needs
# amd_iommu=off, which costs the NPU and DMA remapping, and that is a decision
# the user must make knowingly. post_install prints the guidance instead.

_reponame=onexplayer-x2-mini-pro-cachyos
pkgname=onexplayer-x2mini
pkgver=0.1.0
pkgrel=1
pkgdesc="ONEXPLAYER X2Mini PRO enablement: steamos-manager, InputPlumber, HDR and fan/charge configs"
arch=('any')
url="https://github.com/dahui/$_reponame"
license=('GPL-2.0-only')
# Hard dependencies, because this package ships configuration FOR each of them
# and those files are inert without it. Neither steamos-manager nor inputplumber
# is installed by default on CachyOS Handheld Edition, so leaving either
# optional means the buttons or the TDP slider silently do nothing on a fresh
# install -- with no error, because the config files land correctly and simply
# have nothing reading them.
depends=(
	'steamos-manager'   # reads the device profile; exposes the TDP slider
	'inputplumber'      # reads devices.d + capability_maps.d; hwdb autostarts it
	'oxp-tdpd'          # the TDP backend steamos-manager proxies to
	'oxpec-x2mini-dkms' # fan + charge limit
)
optdepends=(
	# NOT a hard dependency, and it cannot be: this package is not on the AUR
	# (it forks ryzen_smu-dkms-git and is meant to be temporary), so a hard
	# depend would be unresolvable for AUR users. TDP *control* works without
	# it; only read-back degrades to a cached value.
	'ryzen-smu-x2mini-dkms: TDP read-back from the SMU PM table, and keeps ryzenadj working. Not on the AUR -- see the GitHub releases page'
	# The display script is inert without gamescope, and harmless. Left optional
	# so this package does not drag a compositor onto a non-gaming install.
	'gamescope: HDR support via the bundled display script'
)
install="$pkgname.install"
source=("$_reponame-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # replaced by `updpkgsums` at release time

package() {
	cd "$srcdir/$_reponame-$pkgver" || exit 1

	# steamos-manager reads only /usr/share -- it has no /etc override path, so
	# this file is lost if the steamos-manager package ever ships its own X2Mini
	# config. Reinstall this package if TDP or the performance profiles stop
	# working after a steamos-manager update.
	install -Dm644 usr/share/steamos-manager/devices/onexplayer-x2-mini.toml \
		"$pkgdir/usr/share/steamos-manager/devices/onexplayer-x2-mini.toml"

	# InputPlumber reads /etc/inputplumber/*.d as overrides on top of
	# /usr/share/inputplumber, so these survive InputPlumber updates.
	install -Dm644 etc/inputplumber/devices.d/50-onexplayer_x2_mini.yaml \
		"$pkgdir/etc/inputplumber/devices.d/50-onexplayer_x2_mini.yaml"
	install -Dm644 etc/inputplumber/capability_maps.d/onexplayer_x2mini.yaml \
		"$pkgdir/etc/inputplumber/capability_maps.d/onexplayer_x2mini.yaml"

	# Sets USE_INPUTPLUMBER=1 so udev autostarts the service; it ships disabled
	# and is activated on device match, which is why nothing worked originally.
	install -Dm644 etc/udev/hwdb.d/61-inputplumber-onexplayer-x2mini.hwdb \
		"$pkgdir/etc/udev/hwdb.d/61-inputplumber-onexplayer-x2mini.hwdb"

	# gamescope scans /etc/gamescope/scripts after its bundled directory, so
	# this survives gamescope updates. Without an entry here gamescope refuses
	# to advertise HDR regardless of --hdr-enabled.
	install -Dm644 etc/gamescope/scripts/onexplayer.x2mini.oled.lua \
		"$pkgdir/etc/gamescope/scripts/onexplayer.x2mini.oled.lua"

	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	for d in README.md docs/*.md; do
		install -Dm644 "$d" "$pkgdir/usr/share/doc/$pkgname/$(basename "$d")"
	done
}
